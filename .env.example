# OddsVault local configuration.
# Copy to .env and adjust. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local cluster created by `make db-init` (see scripts/local-db.sh).
DATABASE_URL=postgres://oddsvault:oddsvault@127.0.0.1:5432/oddsvault?sslmode=disable

# Used by scripts/local-db.sh. Keep the port and credentials in sync with
# DATABASE_URL above.
PGPORT=5432
PGUSER=oddsvault
PGPASSWORD=oddsvault
PGDATABASE=oddsvault

# Cluster location (optional). Defaults to .local/pgdata inside the repo.
# PGDATA=.local/pgdata

# --- Runtime ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080

# Shared secret between the Go API and the Cloudflare Pages worker. Required
# for GET /api/v1/my-bets. Empty disables the check for local development.
JOURNAL_TOKEN=

# --- HTTP timeouts ----------------------------------------------------------
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=20s
DB_CONNECT_TIMEOUT=10s

# Browser origins allowed to call the API directly (comma-separated).
# Only needed for `next dev` on :3000. The deployed site reaches the API through
# the same-origin Cloudflare Pages proxy, so production leaves this empty.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Workers ----------------------------------------------------------------
JOB_INTERVAL=60s
JOB_TIMEOUT=5m
# Run every worker job once at startup (handy in development).
JOB_RUN_ON_START=false

# --- Web (apps/web) ---------------------------------------------------------
# Browser-side API prefix. The static build defaults to `/svc`, which the
# Cloudflare Pages worker proxies to the Go API. `make web-dev` overrides it
# with http://localhost:8080 so `next dev` talks to the local API directly.
# Never put provider credentials behind NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
