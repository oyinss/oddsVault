# Browser-side API prefix.
#
# The production build defaults to `/svc`, which `public/_worker.js` proxies to
# the Go API on Cloudflare Pages. For `next dev` the browser talks to the Go API
# directly, so the API must allow this origin (see CORS_ALLOWED_ORIGINS in the
# repository root .env.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
